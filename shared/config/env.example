# ---------------------------------------------------------------------------
# RCIE environment. Copy to `.env` at the repo root.
# MODE=mock is the default and requires NO credentials and makes NO network calls.
# ---------------------------------------------------------------------------

# Global adapter toggle. mock | live
MODE=mock

# --- Razorpay (payments adapter) -------------------------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/payments.ts
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Claude (llm adapter, L3 verifier) -------------------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/llm.ts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Store adapter ----------------------------------------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/store.ts
DATABASE_URL=

# --- Notifier adapter (human review queue alerts) ---------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/notifier.ts
REVIEW_QUEUE_WEBHOOK_URL=

# --- Config file locations (override only if you relocate them) -------------
RCIE_POLICY_PATH=shared/config/policy.example.json
RCIE_THRESHOLDS_PATH=shared/config/thresholds.json
