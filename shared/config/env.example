# ---------------------------------------------------------------------------
# RCIE environment. Copy to `.env` at the repo root.
# MODE=mock is the default and requires NO credentials and makes NO network calls.
# ---------------------------------------------------------------------------

# Global adapter toggle. mock | live
MODE=mock

# --- Razorpay (payments adapter) -------------------------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/payments.ts
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- LLM (llm adapter, L3 verifier) -----------------------------------------
# Provider toggle. gemini (default) | anthropic. Only LLM_MODE=live requests
# reach either one - see shared/adapters/llm.ts (llmProvider).
LLM_PROVIDER=gemini

# Gemini path (default). Required when LLM_MODE=live and LLM_PROVIDER=gemini.
# Free-tier quota is per-model and the newest flash tiers are capped at 20
# requests/day - one batch exhausts that, after which every claim fail-safes to
# REVIEW and the run measures the rate limiter, not the verifier. Measured
# per-claim latency on a real FraudBench image: gemini-3.5-flash ~10s (the
# default), gemini-3-flash-preview ~4s, gemini-2.5-flash ~39s (exceeds
# verifier.timeout_ms in thresholds.json), gemini-3.8-flash ~6s but quota-capped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic path (opt in with LLM_PROVIDER=anthropic). Required when
# LLM_MODE=live and LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Store adapter ----------------------------------------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/store.ts
DATABASE_URL=

# --- Notifier adapter (human review queue alerts) ---------------------------
# TODO(LIVE): required when MODE=live for shared/adapters/notifier.ts
REVIEW_QUEUE_WEBHOOK_URL=

# --- Config file locations (override only if you relocate them) -------------
RCIE_POLICY_PATH=shared/config/policy.example.json
RCIE_THRESHOLDS_PATH=shared/config/thresholds.json
